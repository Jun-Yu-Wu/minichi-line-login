# Public LINE Login app — fill these values locally or in the hosting platform.
# Do not use the administrator database URL or SUPABASE_SERVICE_ROLE_KEY here.

NODE_ENV=development

# LINE Login channel settings
MINICHI_LINE_LOGIN_CHANNEL_ID=replace_with_line_login_channel_id
MINICHI_LINE_LOGIN_CHANNEL_SECRET=replace_with_line_login_channel_secret
MINICHI_LINE_LOGIN_CALLBACK_URL=http://localhost:4300/api/line-login/callback
# aggressive asks the user to add the configured LINE Official Account when possible.
MINICHI_LINE_LOGIN_BOT_PROMPT=aggressive

# Connection for a dedicated least-privilege database role.
# Prefer a role with USAGE on private and EXECUTE only on private.submit_line_binding_request(...).
# It must not be an administrator role or a BYPASSRLS role.
MINICHI_LINE_LOGIN_DB_URL=postgresql://line_login_ingress:replace_with_password@replace_with_host:5432/postgres
MINICHI_LINE_LOGIN_DB_SSL=true
MINICHI_LINE_LOGIN_DB_POOL_MAX=2

MINICHI_LINE_BINDING_REQUEST_TTL_MINUTES=1440
MINICHI_LINE_VERIFY_TIMEOUT_MS=5000
